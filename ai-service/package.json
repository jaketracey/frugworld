{
  "name": "@frugworld/ai-service",
  "version": "1.0.0",
  "type": "module",
  "description": "AI/LLM integration layer for Frugworld NPC dialogue, blueprints, and memory",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --import tsx src/ai-server.ts",
    "ai": "node --import tsx src/ai-server.ts",
    "watcher": "node --import tsx src/watcher.ts",
    "thoughts": "node --import tsx src/thoughts.ts",
    "generate:assets": "node --import tsx src/generate-assets.ts",
    "generate:textures": "node --import tsx src/generate-assets.ts --textures",
    "generate:models": "node --import tsx src/generate-assets.ts --models",
    "generate:biome": "node --import tsx src/generate-assets.ts --textures --biomes-only",
    "generate:skybox": "node --import tsx src/generate-assets.ts --textures --skyboxes-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "frugworld",
    "ai",
    "npc",
    "dialogue",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@fal-ai/client": "^1.8.1",
    "dotenv": "^17.2.3",
    "openai": "^4.70.0",
    "sharp": "^0.34.5",
    "spacetimedb": "^1.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
