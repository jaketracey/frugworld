# Frugworld Desktop - Environment Configuration
#
# Copy this file to .env and customize as needed.
# These settings are used during development and can be overridden
# in the Tauri app's settings at runtime.

# ==============================================================================
# AI Provider Mode
# ==============================================================================
# Options:
#   local-only   - Use only local models via Ollama (fully offline)
#   cloud-only   - Use cloud APIs only (requires API keys)
#   hybrid       - Prefer local, fall back to cloud
#   auto         - Automatically choose based on availability
AI_PROVIDER_MODE=local-only

# ==============================================================================
# Ollama Configuration
# ==============================================================================
# Base URL for Ollama API
# Default is localhost - change if running Ollama on another machine
OLLAMA_BASE_URL=http://localhost:11434

# Request timeout in milliseconds (default: 120000 = 2 minutes)
OLLAMA_TIMEOUT=120000

# ==============================================================================
# Model Configuration
# ==============================================================================
# LLM model for NPC dialogue (should be fast, can be smaller)
# Recommended: llama3.2:3b, phi3:mini, mistral:7b-instruct
LLM_MODEL_DIALOGUE=llama3.2:3b

# LLM model for blueprint/building generation (should be capable, can be slower)
# Recommended: qwen2.5:7b, codellama:13b, llama3.1:8b
LLM_MODEL_BLUEPRINT=qwen2.5:7b

# LLM model for world/story generation (optional, uses dialogue model if not set)
# Recommended: Same as blueprint or larger
# LLM_MODEL_WORLD=

# TTS voice model (Piper format)
# Options: en_US-lessac-medium, en_US-amy-medium, en_GB-alan-medium
TTS_MODEL=en_US-lessac-medium

# ==============================================================================
# Cloud API Configuration (optional, for hybrid/cloud mode)
# ==============================================================================
# OpenAI API (for GPT models)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic API (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenRouter API (access to multiple providers)
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=anthropic/claude-3-haiku

# ==============================================================================
# Development Settings
# ==============================================================================
# Enable verbose logging
# DEBUG=true

# Development server port (Vite)
# VITE_PORT=5173

# Skip model download check on startup (for faster dev iteration)
# SKIP_MODEL_CHECK=true

# ==============================================================================
# Build Settings
# ==============================================================================
# These are typically set in CI/CD, not in local .env

# macOS Code Signing
# APPLE_CERTIFICATE=base64-encoded-certificate
# APPLE_CERTIFICATE_PASSWORD=certificate-password
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name
# APPLE_ID=your-apple-id@example.com
# APPLE_PASSWORD=app-specific-password
# APPLE_TEAM_ID=XXXXXXXXXX

# Windows Code Signing
# TAURI_SIGNING_PRIVATE_KEY=base64-encoded-key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=key-password
